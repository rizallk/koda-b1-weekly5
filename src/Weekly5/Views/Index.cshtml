@model IEnumerable<UserResponse>

@{
  ViewData["Title"] = "Home Page";
}
<div>
  <h4>Selamat datang di <b>E-Wallet</b>!</h4>
  <p>Pilih akun di bawah ini untuk masuk</p>

  <div class="list-group">
    @foreach (var user in Model)
    {
      <a asp-action="SelectUser" asp-route-id="@user.Id" class="list-group-item list-group-item-action">
        <i class="bi bi-person-fill me-2"></i> @user.Name
      </a>
    }
  </div>
</div>