<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] - E-Wallet</title>

  @* Bootstrap CSS *@
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">

  @* Inter Font *@
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

  @* Local Style CSS *@
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>

<body>
  <main class="container my-4">
    <div class="d-flex justify-content-between align-items-center">
      <h2><i class="bi-wallet2"></i>&nbsp; <b><span class="text-success">E</span>-Wallet</b></h2>
      @if (ViewData["Title"] is not "Home Page") 
      {
        <a asp-action="Exit" class="btn btn-danger btn-sm">Exit</a>
        } else
        {
          <a href="" class="btn btn-primary btn-sm">Create New User</a>
        }
      </div>
    <hr>

    <partial name="_Alert" />

    @RenderBody()

    <hr class="mt-4">
    <footer class="text-center text-muted">
      <small>E-Wallet &copy; 2026</small>
    </footer>
  </main>

  @* Bootstrap JS *@
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
          crossorigin="anonymous"></script>
</body>

</html>