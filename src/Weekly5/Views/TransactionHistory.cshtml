@model IReadOnlyList<Weekly5.DTOs.UserTransaction>
@{
  ViewData["Title"] = "Riwayat Transaksi";
}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Riwayat Transaksi</h4>
    <a asp-action="Dashboard" class="btn btn-secondary btn-sm">Kembali ke Dashboard</a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Tanggal</th>
              <th>Tipe Transaksi</th>
              <th>Deskripsi</th>
              <th class="text-end">Nominal</th>
            </tr>
          </thead>
          <tbody>
            @if (Model != null && Model.Any())
            {
              foreach (var item in Model)
              {
                <tr>
                  <td>@item.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                  <td>
                    <span
                      class="badge @(item.Type.ToLower() == "income" || item.Type.ToLower() == "topup" ? "bg-success" : "bg-danger")">
                      @item.Type.ToUpper()
                    </span>
                  </td>
                  <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                  <td class="text-end fw-bold @(item.Type.ToLower() == "expense" ? "text-danger" : "text-success")">
                    @(item.Type.ToLower() == "expense" ? "-" : "+") Rp @item.Amount.ToString("N2")
                  </td>
                </tr>
              }
            }
            else
            {
              <tr>
                <td colspan="4" class="text-center text-muted py-4">
                  Belum ada transaksi di wallet ini.
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>