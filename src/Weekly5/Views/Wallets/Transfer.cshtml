@model Weekly5.ViewModels.TransferViewModel
@{
  ViewData["Title"] = "Transfer Saldo";
}

<div>
  <h4 class="mb-4">Transfer</h4>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <form asp-action="Transfer" method="post">
        <input type="hidden" asp-for="SenderUserId" />
                    
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
          <label asp-for="ReceiverWalletNumber" class="form-label fw-bold"></label>
          <input asp-for="ReceiverWalletNumber" class="form-control" placeholder="Contoh: W001" />
          <span asp-validation-for="ReceiverWalletNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Amount" class="form-label fw-bold">Nominal (Rp)</label>
          <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0" />
          <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-4">
          <label asp-for="Description" class="form-label fw-bold"></label>
          <textarea asp-for="Description" class="form-control" rows="2" placeholder="Catatan opsional..."></textarea>
        </div>

        <div class="d-flex justify-content-between">
          <a asp-action="Dashboard" class="btn btn-outline-secondary">Kembali</a>
          <button type="submit" class="btn btn-primary">Kirim Dana</button>
        </div>
      </form>
    </div>
  </div>
</div>