@model TopUpViewModel

@{
  ViewData["Title"] = "Top Up";
}

<form asp-action="TopUp" method="post">
  <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

  <!-- Product Name -->
  @* <div class="mb-3">
    <label asp-for="Name" class="form-label fw-bold"></label>
    <input asp-for="Name" class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
           placeholder="Masukkan Name Product" />
    <span asp-validation-for="Name" class="invalid-feedback"></span>
  </div> *@

  <div class="mb-3">
    <label asp-for="Balance" class="form-label fw-bold"></label>
    <div class="input-group has-validation">
      <span class="input-group-text">Rp</span>
      <input asp-for="Balance" type="number" min="0" step="0.01"
             class="form-control @(ViewData.ModelState["Balance"]?.Errors.Count > 0 ? "is-invalid" : "")"
             placeholder="Masukkan nominal" />
      <span asp-validation-for="Balance" class="invalid-feedback"></span>
    </div>
  </div>

