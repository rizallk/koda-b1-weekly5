@model Weekly5.ViewModels.UserViewModel
@{
  ViewData["Title"] = "Edit Profil";
  var userId = ViewData["Id"];
}

<div>
  <h4 class="mb-4">Edit</h4>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <form asp-action="Edit" asp-route-id="@userId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
          <label asp-for="Name" class="form-label fw-bold">Nama Lengkap</label>
          <input asp-for="Name" class="form-control" />
          <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Email" class="form-label fw-bold">Alamat Email</label>
          <input asp-for="Email" type="email" class="form-control" />
          <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
          <label asp-for="Phone" class="form-label fw-bold">No. Telepon / HP</label>
          <input asp-for="Phone" class="form-control" />
          <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
          <a asp-action="Dashboard" class="btn btn-outline-secondary">Kembali</a>
          <button type="submit" class="btn btn-success">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </div>
</div>