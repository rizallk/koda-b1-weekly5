@model Weekly5.ViewModels.UserViewModel
@{
  ViewData["Title"] = "Create";
}

<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow">
      <div class="card-body p-4">
        <h4 class="card-title text-center mb-4">Buat Akun Baru</h4>
        <form asp-action="Create" method="post">
          <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

          <div class="mb-3">
            <label asp-for="Name" class="form-label">Nama</label>
            <input asp-for="Name" class="form-control" placeholder="Masukkan Nama" />
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>

          <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Masukkan Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
          </div>

          <div class="mb-4">
            <label asp-for="Phone" class="form-label">No. Telepon / HP</label>
            <input asp-for="Phone" class="form-control" placeholder="Masukkan No HP" />
            <span asp-validation-for="Phone" class="text-danger"></span>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Buat</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>